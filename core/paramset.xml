  <SXmlObject SXmlObjectTYPE="paramset" SXmlObjectID="PARAMSET_COUNTRIES">
    <repository>core</repository>
    <alias>Countries</alias>
    <parentID>DATASET_COUNTRIES</parentID>
    <param>
      <bind>countries.`country_code`</bind>
      <type>string</type>
      <list enabled="true">
        <query>SELECT DISTINCT
`country_code`
FROM `${SCHEMA}`.`countries` countries
ORDER BY `country_code` LIMIT 30000</query>
        <columnset>COUNTRY_CODE</columnset>
        <factor>country_code</factor>
      </list>
    </param>
